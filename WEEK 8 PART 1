import csv

students = []
csv_loaded = False


def load_csv(filename):
    """Load student records from a CSV file."""
    global students, csv_loaded

    try:
        with open(filename, "r", newline="") as file:
            reader = csv.DictReader(file)
            new_students = []

            for row in reader:
                new_students.append(row)

            students = new_students
            csv_loaded = True

            print(
                f"Success! {len(students)} "
                "student record(s) loaded"
            )

    except FileNotFoundError:
        print(f"Error: File '{filename}' was not found.")
    except (OSError, csv.Error) as error:
        print(f"Error reading file: {error}")


def list_students():
    """Display all loaded student records."""
    if not csv_loaded:
        print("Please load a CSV file first.")
        return

    print("\nStudent Records")
    print("-" * 75)

    for number, student in enumerate(students, start=1):
        print(
            f"{number}. {student['StudentID']} | "
            f"{student['StudentName']} | "
            f"{student['Major']} | "
            f"{student['GPA']} | "
            f"{student['TotalCredits']}"
        )


def search_by_id(search_id):
    """Find a student using a linear search."""
    if not csv_loaded:
        print("Please load a CSV file first.")
        return

    search_id = search_id.strip().upper()

    for student in students:
        if student["StudentID"].strip().upper() == search_id:
            print("\nStudent Found:")
            print(
                f"{student['StudentID']} | "
                f"{student['StudentName']} | "
                f"{student['Major']} | "
                f"{student['GPA']} | "
                f"{student['TotalCredits']}"
            )
            return

    print(f"No student found with ID '{search_id}'")


def run():
    """Display the menu and process user choices."""
    while True:
        print("\nStudent Record Management System")
        print("1. Read CSV")
        print("2. List CSV Contents")
        print("3. Search for Student by ID")
        print("4. Exit")

        choice = input("Enter your choice: ").strip()

        if choice == "1":
            filename = input("Enter filename: ").strip()
            load_csv(filename)

        elif choice == "2":
            list_students()

        elif choice == "3":
            search_id = input("Enter student ID: ")
            search_by_id(search_id)

        elif choice == "4":
            print("Goodbye!")
            break

        else:
            print("Invalid choice. Please try again.")


if __name__ == "__main__":
    run()

