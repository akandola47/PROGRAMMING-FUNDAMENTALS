class Book:

    def __init__(self, title, author, isbn, year, genre):
        self.title = title
        self.author = author
        self.isbn = isbn
        self.year = year
        self.genre = genre
        self.available = True
        self.borrower = None

    def __str__(self):
        return f"{self.isbn:<17} {self.title:<35} {self.author:<25} {self.year:<6} {self.genre:<18} {self.get_status()}"

    def check_out(self, patron_name):
        if self.available:
            self.available = False
            self.borrower = patron_name
            return True
        return False

    def return_book(self):
        self.available = True
        self.borrower = None
        return f"'{self.title}' has been returned and is now available."

    def get_status(self):
        if self.available:
            return "Available"
        return f"Checked out to {self.borrower}"

    
collection = [
